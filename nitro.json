{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "nitrolndltc"
  ],
  "ios": {
    "iosModuleName": "NitroLndltc"
  },
  "android": {
    "androidNamespace": [
      "nitrolndltc"
    ],
    "androidCxxLibName": "NitroLndltc"
  },
  "autolinking": {
    "Lnd": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridLnd"
      }
    },
    "Subscription": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridSubscription"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
